# ADDED FOR DEPLOYMENT — copy this to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/Livestock?retryWrites=true&w=majority

# JWT secret key — generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Google Gemini API key (for AI assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (if used)
GROQ_API_KEY=your_groq_api_key_here

# Path to ML model files (defaults to ./models/ relative to backend)
MODELS_DIR=./models

# Port (Render sets this automatically — do not set manually on Render)
PORT=8000
